# The uv server type forbids shipping a resolved environment — the host
# installs from pyproject.toml instead.
.venv/
venv/
server/lib/
server/venv/

# NOTE: *.whl is deliberately NOT ignored. The bundle ships the wheel that
# [tool.uv.sources] resolves against until 0.2.1 reaches PyPI.

__pycache__/
*.py[cod]
.DS_Store
